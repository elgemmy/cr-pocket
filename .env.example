# --- Web client (public, bundled into the frontend) ---
# Firebase web app config (Firebase console > Project settings > Your apps).
# Leave empty to run in local demo mode (fake user, decks stored in localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Use local Firebase emulators (npm run emulators) instead of the real project.
VITE_FIREBASE_EMULATORS=false

# Game data source: "demo" = bundled sample data, "live" = /api/* Pages Functions.
VITE_GAME_API=demo

# --- Server only (Cloudflare Pages secrets / .dev.vars, NEVER prefixed with VITE_) ---
# See .dev.vars.example.
